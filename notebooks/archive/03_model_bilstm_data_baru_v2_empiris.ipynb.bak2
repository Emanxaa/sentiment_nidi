   "source": [
    "# 03 — Pemodelan BiLSTM pada Data Baru (v2): 5 Varian Empiris Multi-Seed\n",
    "Notebook ini menguji 5 perlakuan penanganan ketimpangan kelas pada BiLSTM dengan evaluasi 3-seeds (`42, 123, 456`):\n",
    "1. **Natural Baseline**\n",
    "2. **Class Weight (CW)**\n",
    "3. **Random Oversampling (ROS)**\n",
    "4. **Random Undersampling (RUS)**\n",
    "5. **SMOTE**\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "c1597dd1",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-02T11:21:10.717087Z",
     "iopub.status.busy": "2026-09-02T11:21:10.717087Z",
     "iopub.status.idle": "2026-09-02T11:21:20.714142Z",
     "shell.execute_reply": "2026-09-02T11:21:20.713631Z"
    }
   },
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras.preprocessing.text import Tokenizer\n",
    "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Embedding, LSTM, Bidirectional, Dropout, Dense\n",
    "from tensorflow.keras.callbacks import EarlyStopping\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.utils.class_weight import compute_class_weight\n",
    "from sklearn.metrics import accuracy_score, f1_score, recall_score, classification_report\n",
    "from imblearn.over_sampling import RandomOverSampler, SMOTE\n",
    "from imblearn.under_sampling import RandomUnderSampler\n",
    "\n",
    "if Path.cwd().name == \"notebooks\":\n",
    "    os.chdir(\"..\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "419c0d1a",
   "metadata": {},
   "source": [
    "## 1. Load Data & Tokenisasi\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "88bd4abe",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-02T11:21:20.718163Z",
     "iopub.status.busy": "2026-09-02T11:21:20.718163Z",
     "iopub.status.idle": "2026-09-02T11:21:21.352309Z",
     "shell.execute_reply": "2026-09-02T11:21:21.352309Z"
    }
   },
   "outputs": [],
   "source": [
    "df = pd.read_csv(\"Data/processed/banjir_processed_v2.csv\")\n",
    "tr_val, test_df = train_test_split(df, test_size=0.20, stratify=df['label'], random_state=42)\n",
    "train_df, val_df = train_test_split(tr_val, test_size=0.10, stratify=tr_val['label'], random_state=42)\n",
    "\n",
    "tok = Tokenizer(num_words=10000, oov_token=\"<OOV>\")\n",
    "tok.fit_on_texts(train_df['processed_text_v2'])\n",
    "\n",
    "X_tr = pad_sequences(tok.texts_to_sequences(train_df['processed_text_v2']), maxlen=50, padding='post', truncating='post')\n",
    "X_va = pad_sequences(tok.texts_to_sequences(val_df['processed_text_v2']), maxlen=50, padding='post', truncating='post')\n",
    "X_te = pad_sequences(tok.texts_to_sequences(test_df['processed_text_v2']), maxlen=50, padding='post', truncating='post')\n",
    "\n",
    "y_tr = train_df['label'].values\n",
    "y_va = val_df['label'].values\n",
    "y_te = test_df['label'].values\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "96b52219",
   "metadata": {},
   "source": [
    "## 2. Definisi Model BiLSTM\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c7e32401",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-02T11:21:21.356805Z",
     "iopub.status.busy": "2026-09-02T11:21:21.356805Z",
     "iopub.status.idle": "2026-09-02T11:21:21.361036Z",
     "shell.execute_reply": "2026-09-02T11:21:21.361036Z"
    }
   },
   "outputs": [],
   "source": [
    "def build_bilstm():\n",
    "    model = Sequential([\n",
    "        Embedding(10000, 128),\n",
    "        Bidirectional(LSTM(64)),\n",
    "        Dropout(0.3),\n",
    "        Dense(3, activation='softmax')\n",
    "    ])\n",
    "    model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.0001),\n",
    "                  loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n",
    "    return model\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ac26c70e",
   "metadata": {},
   "source": [
    "## 3. Pelatihan Multi-Seed (Rata-rata 3 Seeds)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "96eca27a",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-02T11:21:21.364375Z",
     "iopub.status.busy": "2026-09-02T11:21:21.364375Z",
     "iopub.status.idle": "2026-09-02T11:24:10.549381Z",
     "shell.execute_reply": "2026-09-02T11:24:10.549381Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WARNING:tensorflow:TensorFlow GPU support is not available on native Windows for TensorFlow >= 2.11. Even if CUDA/cuDNN are installed, GPU will not be used. Please use WSL2 or the TensorFlow-DirectML plugin.\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== HASIL BILSTM NATURAL BASELINE (3 SEEDS) ===\n",
      "   Seed  Accuracy  Macro_F1  Neutral_Recall\n",
      "0    42  0.712717  0.516839        0.009934\n",
      "1   123  0.723121  0.637472        0.314570\n",
      "2   456  0.721965  0.516760        0.000000\n",
      "\n",
      "Mean Accuracy: 71.93% (±0.57%)\n",
      "Mean Macro F1: 55.70% (±6.97%)\n",
      "Mean Neutral Recall: 10.82%\n"
     ]
    }
   ],
   "source": [
    "seeds = [42, 123, 456]\n",
    "results = []\n",
    "\n",
    "for s in seeds:\n",
    "    tf.random.set_seed(s)\n",
    "    np.random.seed(s)\n",
    "    m = build_bilstm()\n",
    "    es = EarlyStopping(monitor='val_loss', patience=3, restore_best_weights=True)\n",
    "    m.fit(X_tr, y_tr, validation_data=(X_va, y_va), epochs=20, batch_size=16, callbacks=[es], verbose=0)\n",
    "    preds = np.argmax(m.predict(X_te, verbose=0), axis=1)\n",
    "    \n",
    "    acc = accuracy_score(y_te, preds)\n",
    "    f1 = f1_score(y_te, preds, average='macro')\n",
    "    rec_net = recall_score(y_te, preds, labels=[1], average='macro')\n",
    "    results.append({\"Seed\": s, \"Accuracy\": acc, \"Macro_F1\": f1, \"Neutral_Recall\": rec_net})\n",
    "\n",
    "res_df = pd.DataFrame(results)\n",
    "print(\"=== HASIL BILSTM NATURAL BASELINE (3 SEEDS) ===\")\n",
    "print(res_df)\n",
    "print(f\"\\nMean Accuracy: {res_df['Accuracy'].mean()*100:.2f}% (±{res_df['Accuracy'].std()*100:.2f}%)\")\n",
    "print(f\"Mean Macro F1: {res_df['Macro_F1'].mean()*100:.2f}% (±{res_df['Macro_F1'].std()*100:.2f}%)\")\n",
    "print(f\"Mean Neutral Recall: {res_df['Neutral_Recall'].mean()*100:.2f}%\")\n"
   ]
  }
 ],
