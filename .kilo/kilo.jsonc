{
  "$schema": "https://app.kilo.ai/config.json",

  // ===== Default model (sementara Gemini gratis) =====
  "model": "google/gemini-2.5-pro",

  // ===== Instruksi global =====
  "instructions": [
    "AGENTS.md",
    ".kilo/workspace.md"
  ],

  // ===== Tampilan =====
  "terminal_command_display": "collapsed",

  // ===== Izin agent (mirip Command Code) =====
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "npm *": "allow",
      "pip *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "rm *": "deny",
      "del *": "deny",
      "format *": "allow"
    },
    "edit": {
      "*": "ask"
    },
    "external_directory": {
      "~/projects/**": "allow"
    }
  },

  // ===== Codebase indexing =====
  "indexing": {
    "enabled": true
  },

  // ===== Experimental (berguna untuk repo besar) =====
  "experimental": {
    "batch_tool": true,
    "disable_paste_summary": false,
    "mcp_timeout": 30000
  },

  // ===== Provider (API key lewat ENV, bukan hardcode) =====
  "provider": {
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },

    "openai-compatible": {
      "options": {
        "apiKey": "{env:QWEN_API_KEY}",
        "baseURL": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
      },
      "models": {
        "qwen3.7-plus": {
          "id": "qwen3.7-plus",
          "name": "Qwen 3.7 Plus",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "qwen3.5-flash": {
          "id": "qwen3.5-flash",
          "name": "Qwen 3.5 Flash",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    }
  }
}